{
  "manifest_version": 3,
  "name": "Jotty: AI Study Focus & Reflection",
  "version": "1.0.0",
  "description": "A local-first study coach. Judges pages against your task, nudges you back, delays distractions, and asks about yesterday.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Jotty",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2", "icons/*.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "minimum_chrome_version": "116"
}
